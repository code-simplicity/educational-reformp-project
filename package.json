{
	"name": "educational-reformp-project",
	"private": true,
	"version": "0.1.0",
	"scripts": {
		"dev": "vite",
		"build": "vite build --mode=production",
		"preview": "vite preview",
		"lint": "eslint --ext .js,.vue src",
		"lint:fix": "eslint --ext .js,.vue src --fix",
		"format": "prettier --write \"src/**/*.{js,vue,scss,css}\"",
		"prepare": "husky install"
	},
	"lint-staged": {
		"*.{js,vue}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{scss,css}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@element-plus/icons-vue": "^2.3.1",
		"@xeokit/xeokit-bim-viewer": "^2.4.7-beta-2",
		"animate.css": "^4.1.1",
		"axios": "^0.26.1",
		"core-js": "^3.22.0",
		"dat.gui": "^0.7.9",
		"element-plus": "^2.1.9",
		"nprogress": "^0.2.0",
		"sass": "^1.50.0",
		"screenfull": "^6.0.1",
		"spark-md5": "^3.0.2",
		"stats.js": "^0.17.0",
		"three": "^0.139.2",
		"vue": "^3.2.25",
		"vue-router": "^4.0.14",
		"vuex": "^4.0.2",
		"xgplayer": "^2.31.6"
	},
	"devDependencies": {
		"@eslint/js": "^9.28.0",
		"@vitejs/plugin-vue": "^2.3.1",
		"@vue/eslint-config-prettier": "^10.2.0",
		"eslint": "^9.28.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-define-config": "^2.1.0",
		"eslint-plugin-prettier": "^5.4.1",
		"eslint-plugin-vue": "^10.1.0",
		"husky": "8.0.3",
		"lint-staged": "13.2.3",
		"prettier": "^3.5.3",
		"rollup-plugin-visualizer": "^5.14.0",
		"vite": "^2.9.2",
		"vue-eslint-parser": "^10.1.3"
	}
}
